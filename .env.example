# Copy this file to .env.local and fill it in.
# The site runs with all of these blank: it falls back to the built in content
# and serves media from /public/media. Nothing here can take the page down.

# ---- Supabase -------------------------------------------------------------
# Project settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_ and never commit it.
# Used by the booking route so the public role needs no insert rights.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudinary -----------------------------------------------------------
# Leave blank to serve media from /public/media instead.
# Your cloud name is the segment after res.cloudinary.com in an asset URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_FOLDER=kbs

# ---- Site ----------------------------------------------------------------
# The live origin, used by the sitemap, robots.txt and the social preview tags.
NEXT_PUBLIC_SITE_URL=

# ---- Outgoing mail -----------------------------------------------------
# The contact form, project-inquiry form and booking alerts all deliver here.
# With these blank the forms still succeed; the submission is logged, not sent.
# SMTP_PASS for Gmail is an App Password (Google account > Security), not the
# login password, and the account needs 2-Step Verification enabled.
MAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
