# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values; the template is the one exception
.env*
!.env.example
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# handoff artifacts (not part of the app; public/media is committed instead)
/media/
/kbs-web-source.zip
/dev.log

# source masters kept locally for re-exports. The hero render is 2560x1440 and
# ~450 MB; only its web derivatives ship, and those live on Cloudinary.
/*.mp4
/*.mov
/*.webm

# local reference material dropped in the repo root, not part of the app
/Claude outputs/
/patch-flowers/
/correction needed.txt
/*.docx
