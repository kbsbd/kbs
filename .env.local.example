# Copy this file to .env.local and fill in real values once the Supabase
# project exists. Without these, the site runs fine using bundled demo data
# and /admin shows a "Supabase not configured" message instead of crashing.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build absolute URLs (metadata, sitemap, robots).
# Local: leave as localhost. Production (Vercel): https://kbsbd.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact-form email — Gmail SMTP with an App Password.
# Google Account → Security → 2-Step Verification → App passwords.
# Without these the forms still save to the leads table; they just don't email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kbsbdinfo@gmail.com
SMTP_PASS=
SMTP_FROM=KBS Website <info@kbsbd.com>
LEAD_NOTIFY_TO=info@kbsbd.com
