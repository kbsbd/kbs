# Copy this file to .env.local and fill in real values once the Supabase
# project exists. Without these, the site runs fine using bundled demo data
# and /admin shows a "Supabase not configured" message instead of crashing.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build absolute URLs (metadata, sitemap, robots). Set to the real
# production domain once known.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
